{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/core/src/index.ts",
    "packages/core/src/schema/index.ts",
    "packages/core/src/profile/index.ts",
    "packages/core/src/profile/profiles.ts",
    "packages/core/src/io/index.ts",
    "packages/core/src/csv/index.ts",
    "packages/core/src/rtf/index.ts",
    "packages/core/src/ooxml/index.ts",
    "packages/core/src/ooxml/xlsx/index.ts",
    "packages/core/src/ooxml/docx/index.ts",
    "packages/core/src/ooxml/pptx/index.ts",
    "packages/core/src/pdf/index.ts",
    "packages/core/src/pdf/cos/index.ts",
    "packages/core/src/iwork/index.ts",
    "packages/core/src/iwork/pages.ts",
    "packages/core/src/iwork/numbers.ts",
    "packages/core/src/iwork/keynote.ts",
    "packages/core/src/iwork/codec.ts",
    "packages/core/test/**/*.test.ts",
    "test/**/*.test.ts",
    "test/**/*.types.ts",
    "examples/*.ts",
    "bench/*.bench.ts",
    "**/vite.config.ts",
    "vite.package.ts",
    "scripts/check-dist-imports.mjs",
    "scripts/fetch-corpora.mjs"
  ],
  "ignorePatterns": ["**/dist/**", "**/coverage/**"],
  "ignoreDependencies": [
    "@types/node",
    "@effect/tsgo",
    "@effect/language-service",
    "@typescript/native",
    "typescript",
    "vite",
    "vitest",
    "vite-plus",
    "@changesets/cli",
    "@changesets/changelog-github",
    "@vitest/coverage-istanbul",
    "fallow"
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "warn",
    "unused-enum-members": "error",
    "unused-class-members": "warn",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "stale-suppressions": "warn"
  },
  "boundaries": {
    "zones": [
      {
        "name": "core",
        "patterns": [
          "packages/core/src/index.ts",
          "packages/core/src/schema/**",
          "packages/core/src/profile/**",
          "packages/core/src/io/**",
          "packages/core/test/schema/**",
          "packages/core/test/profile/**",
          "packages/core/test/*.ts"
        ]
      },
      {
        "name": "csv",
        "patterns": ["packages/core/src/csv/**", "packages/core/test/csv/**"]
      },
      {
        "name": "iwork",
        "patterns": ["packages/core/src/iwork/**", "packages/core/test/iwork/**"]
      },
      {
        "name": "ooxml",
        "patterns": ["packages/core/src/ooxml/**", "packages/core/test/ooxml/**"]
      },
      {
        "name": "pdf",
        "patterns": ["packages/core/src/pdf/**", "packages/core/test/pdf/**"]
      },
      {
        "name": "rtf",
        "patterns": ["packages/core/src/rtf/**", "packages/core/test/rtf/**"]
      }
    ],
    "rules": [
      {
        "from": "core",
        "allow": []
      },
      {
        "from": "csv",
        "allow": ["core"]
      },
      {
        "from": "iwork",
        "allow": ["core"]
      },
      {
        "from": "ooxml",
        "allow": ["core"]
      },
      {
        "from": "pdf",
        "allow": ["core"]
      },
      {
        "from": "rtf",
        "allow": ["core"]
      }
    ]
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "coverage": "coverage/coverage-final.json"
  }
}
