{
  "name": "@effect-pandoc/csv",
  "version": "0.2.0",
  "description": "CSV/TSV reader and writer for effect-pandoc - dialects, streaming, type inference, and data synthesis",
  "type": "module",
  "module": "src/index.ts",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./legacy": {
      "types": "./src/legacy.ts",
      "bun": "./src/legacy.ts",
      "import": "./src/legacy.ts",
      "default": "./src/legacy.ts"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts src/legacy.ts --outdir dist --target node --format esm --external effect --external @effect-pandoc/core"
  },
  "keywords": [
    "effect",
    "pandoc",
    "csv",
    "tsv",
    "parser",
    "stream"
  ],
  "license": "MIT",
  "dependencies": {
    "@effect-pandoc/core": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^3.10.0"
  }
}
