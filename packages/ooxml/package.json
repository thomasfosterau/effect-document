{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/effect-ooxml",
  "version": "0.0.0",
  "description": "Office Open XML (xlsx, docx, pptx) readers and writers for effect-document",
  "keywords": [
    "document",
    "docx",
    "effect",
    "excel",
    "ooxml",
    "powerpoint",
    "pptx",
    "word",
    "xlsx"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-document/tree/main/packages/ooxml#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-document/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-document.git",
    "directory": "packages/ooxml"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./xlsx": {
      "types": "./dist/xlsx.d.ts",
      "default": "./dist/xlsx.js"
    },
    "./docx": {
      "types": "./dist/docx.d.ts",
      "default": "./dist/docx.js"
    },
    "./pptx": {
      "types": "./dist/pptx.d.ts",
      "default": "./dist/pptx.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@thomasfosterau/effect-document": "workspace:^",
    "@thomasfosterau/effect-parse": "catalog:",
    "fflate": "catalog:"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22"
  }
}
