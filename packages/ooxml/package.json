{
  "name": "@thomasfosterau/effect-ooxml",
  "version": "0.1.0",
  "description": "Office Open XML (xlsx, docx, pptx) readers and writers for effect-document",
  "type": "module",
  "module": "src/index.ts",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./xlsx": {
      "types": "./src/xlsx/index.ts",
      "bun": "./src/xlsx/index.ts",
      "import": "./src/xlsx/index.ts",
      "default": "./src/xlsx/index.ts"
    },
    "./docx": {
      "types": "./src/docx/index.ts",
      "bun": "./src/docx/index.ts",
      "import": "./src/docx/index.ts",
      "default": "./src/docx/index.ts"
    },
    "./pptx": {
      "types": "./src/pptx/index.ts",
      "bun": "./src/pptx/index.ts",
      "import": "./src/pptx/index.ts",
      "default": "./src/pptx/index.ts"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/xlsx/index.ts src/docx/index.ts src/pptx/index.ts --root src --outdir dist --target node --format esm --packages external",
    "test": "bun test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-document.git",
    "directory": "packages/ooxml"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "effect",
    "document",
    "ooxml",
    "xlsx",
    "excel",
    "docx",
    "word",
    "pptx",
    "powerpoint"
  ],
  "author": "Thomas Foster <me@thomasfoster.au>",
  "license": "MIT",
  "dependencies": {
    "@thomasfosterau/effect-document": "^0.2.0",
    "@thomasfosterau/effect-parse": "^0.1.0",
    "fflate": "^0.8.2"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  }
}
