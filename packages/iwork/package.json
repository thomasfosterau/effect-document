{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/effect-iwork",
  "version": "0.1.0",
  "description": "Experimental, read-only Apple iWork (Pages, Numbers, Keynote) readers for effect-document",
  "keywords": [
    "document",
    "effect",
    "iwork",
    "keynote",
    "numbers",
    "pages"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-document/tree/main/packages/iwork#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-document/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-document.git",
    "directory": "packages/iwork"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pages": {
      "types": "./dist/pages.d.ts",
      "default": "./dist/pages.js"
    },
    "./numbers": {
      "types": "./dist/numbers.d.ts",
      "default": "./dist/numbers.js"
    },
    "./keynote": {
      "types": "./dist/keynote.d.ts",
      "default": "./dist/keynote.js"
    },
    "./codec": {
      "types": "./dist/codec.d.ts",
      "default": "./dist/codec.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@thomasfosterau/effect-document": "workspace:^",
    "@thomasfosterau/effect-parse": "catalog:",
    "fflate": "catalog:"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/platform-node": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22"
  }
}
