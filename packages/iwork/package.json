{
  "name": "@thomasfosterau/effect-document-iwork",
  "version": "0.0.0",
  "description": "Experimental, read-only Apple iWork (Pages, Numbers, Keynote) readers for effect-document",
  "type": "module",
  "module": "src/index.ts",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./pages": {
      "types": "./src/pages.ts",
      "bun": "./src/pages.ts",
      "import": "./src/pages.ts",
      "default": "./src/pages.ts"
    },
    "./numbers": {
      "types": "./src/numbers.ts",
      "bun": "./src/numbers.ts",
      "import": "./src/numbers.ts",
      "default": "./src/numbers.ts"
    },
    "./keynote": {
      "types": "./src/keynote.ts",
      "bun": "./src/keynote.ts",
      "import": "./src/keynote.ts",
      "default": "./src/keynote.ts"
    },
    "./codec": {
      "types": "./src/codec.ts",
      "bun": "./src/codec.ts",
      "import": "./src/codec.ts",
      "default": "./src/codec.ts"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/pages.ts src/numbers.ts src/keynote.ts src/codec.ts --root src --outdir dist --target node --format esm --packages external",
    "test": "bun test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-document.git",
    "directory": "packages/iwork"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "effect",
    "document",
    "iwork",
    "pages",
    "numbers",
    "keynote"
  ],
  "author": "Thomas Foster <me@thomasfoster.au>",
  "license": "MIT",
  "dependencies": {
    "@thomasfosterau/effect-document": "^0.1.0",
    "@thomasfosterau/effect-parse": "^0.1.0",
    "fflate": "^0.8.2"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  }
}
