{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/effect-document",
  "version": "0.1.0",
  "description": "Effect-native, type-safe universal document schema - profile-based subsets for documents, spreadsheets and presentations, with the Reader/Writer/Format abstractions and lossy-aware conversion",
  "keywords": [
    "effect",
    "document",
    "schema",
    "pandoc",
    "converter"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-document/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-document/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-document.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./profile": {
      "types": "./dist/profile.d.ts",
      "default": "./dist/profile.js"
    },
    "./profiles": {
      "types": "./dist/profiles.d.ts",
      "default": "./dist/profiles.js"
    },
    "./io": {
      "types": "./dist/io.d.ts",
      "default": "./dist/io.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22"
  }
}
