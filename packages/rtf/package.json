{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/effect-rtf",
  "version": "0.0.0",
  "description": "Rich Text Format reader and writer for effect-document",
  "keywords": [
    "effect",
    "document",
    "rtf"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-document/tree/main/packages/rtf#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-document/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-document.git",
    "directory": "packages/rtf"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@thomasfosterau/effect-document": "workspace:^",
    "@thomasfosterau/effect-parse": "catalog:"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22"
  }
}
