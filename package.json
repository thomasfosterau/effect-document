{
  "$schema": "https://www.schemastore.org/package",
  "name": "effect-document-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for the @thomasfosterau/effect-document package family: an Effect-native universal document schema with profile-based subsets, plus CSV, OOXML, iWork, PDF and RTF readers and writers.",
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && vp fmt && pnpm install --lockfile-only",
    "release": "vp run -r build && pnpm -r --filter './packages/*' publish --access public --no-git-checks --ignore-scripts && changeset tag",
    "fallow": "fallow --summary",
    "fallow:audit": "fallow audit",
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@enfect/oxlint": "catalog:",
    "@thomasfosterau/effect-csv": "workspace:*",
    "@thomasfosterau/effect-document": "workspace:*",
    "@thomasfosterau/effect-iwork": "workspace:*",
    "@thomasfosterau/effect-ooxml": "workspace:*",
    "@thomasfosterau/effect-pdf": "workspace:*",
    "@thomasfosterau/effect-rtf": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:",
    "fallow": "catalog:",
    "fflate": "catalog:",
    "publint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.28.6"
}
