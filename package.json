{
  "name": "effect-document-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@thomasfosterau/effect-document": "workspace:*",
    "@thomasfosterau/effect-csv": "workspace:*",
    "@thomasfosterau/effect-iwork": "workspace:*",
    "@thomasfosterau/effect-ooxml": "workspace:*",
    "@thomasfosterau/effect-rtf": "workspace:*",
    "@types/bun": "latest",
    "effect": "^4.0.5",
    "fflate": "^0.8.2",
    "typescript": "^5.7.2"
  }
}
