{
  "name": "effect-pandoc",
  "version": "0.2.0",
  "description": "Effect-native document conversion toolkit - readers and writers for tabular and document formats with a universal intermediate representation",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '@effect-pandoc/*' build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "effect",
    "pandoc",
    "csv",
    "xlsx",
    "excel",
    "converter",
    "document",
    "parser",
    "stream"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.2",
    "effect": "^3.19.0",
    "@effect-pandoc/core": "workspace:*",
    "@effect-pandoc/csv": "workspace:*",
    "@effect-pandoc/xlsx": "workspace:*",
    "effect-csv": "workspace:*"
  }
}
