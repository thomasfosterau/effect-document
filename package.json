{
  "$schema": "https://www.schemastore.org/package",
  "name": "effect-document-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for @thomasfosterau/effect-document: an Effect-native universal document schema with profile-based subsets, and CSV, OOXML, iWork, PDF and RTF readers and writers on its subpaths.",
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "type": "module",
  "scripts": {
    "version": "changeset version && vp fmt && pnpm install --lockfile-only",
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@enfect/oxlint": "catalog:",
    "@thomasfosterau/effect-document": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:",
    "fallow": "catalog:",
    "fflate": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "lts"
    }
  },
  "packageManager": "pnpm@12.21.0"
}
