{
  "name": "effect-document",
  // The Vite+ base image at the catalog's `vite-plus` version.
  "image": "ghcr.io/voidzero-dev/vite-plus:1.6.0",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers-extra/features/ripgrep:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainer-community/devcontainer-features/jq:1": {},
    // xmllint, for `vp run test:validate`.
    "ghcr.io/devcontainers-extra/features/apt-packages:1": {
      "packages": "libxml2-utils"
    }
  },
  "postCreateCommand": "vp install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": ["Anthropic.claude-code", "oxc.oxc-vscode"]
    }
  },
  "workspaceFolder": "/workspaces/effect-document"
}
