{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    // Copied from the effect-web library family's base so every package here
    // compiles under exactly the options its consumers use. `erasableSyntaxOnly` because the
    // apps load TypeScript under Node's strip-only loader; a library file that
    // uses enums / namespaces / parameter properties would fail there.
    "erasableSyntaxOnly": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    // Source imports are written `./x.ts`; the build rewrites them to `./x.js`
    // in the emitted JavaScript. The emitted `.d.ts` keeps `./x.ts`, which
    // both `bundler` and `nodenext` consumers resolve (verified 2026-09-18).
    "rewriteRelativeImportExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    // Optional members are spelled `?: T | undefined` because of this flag: a
    // consumer forwarding an optional of its own must still compile.
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    // Stricter than the family base, kept from this repo's original config:
    // every index read is `T | undefined`, and no switch case falls through.
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    // Every workspace package name resolves to its `src/`, in every program
    // (each package's `tsconfig.json` / `tsconfig.test.json`, the root one).
    // The `exports` point at `dist/`, which does not exist before
    // `vp run -r build`; without this, the type-aware lint in `vp check`
    // (oxlint-tsgolint, which reads these configs) types every sibling
    // import as `error` on a clean tree. What consumers see in `dist/` is
    // still checked by `vp run check:pack` (and `check:dist`). Paths here are
    // relative to this file; a config that sets its own `paths` replaces
    // this map, so none does.
    "paths": {
      "@thomasfosterau/effect-document": ["./packages/core/src/index.ts"],
      "@thomasfosterau/effect-document/schema": ["./packages/core/src/schema/index.ts"],
      "@thomasfosterau/effect-document/profile": ["./packages/core/src/profile/index.ts"],
      "@thomasfosterau/effect-document/profiles": ["./packages/core/src/profile/profiles.ts"],
      "@thomasfosterau/effect-document/io": ["./packages/core/src/io/index.ts"],
      "@thomasfosterau/effect-csv": ["./packages/csv/src/index.ts"],
      "@thomasfosterau/effect-iwork": ["./packages/iwork/src/index.ts"],
      "@thomasfosterau/effect-iwork/pages": ["./packages/iwork/src/pages.ts"],
      "@thomasfosterau/effect-iwork/numbers": ["./packages/iwork/src/numbers.ts"],
      "@thomasfosterau/effect-iwork/keynote": ["./packages/iwork/src/keynote.ts"],
      "@thomasfosterau/effect-iwork/codec": ["./packages/iwork/src/codec.ts"],
      "@thomasfosterau/effect-ooxml": ["./packages/ooxml/src/index.ts"],
      "@thomasfosterau/effect-ooxml/xlsx": ["./packages/ooxml/src/xlsx/index.ts"],
      "@thomasfosterau/effect-ooxml/docx": ["./packages/ooxml/src/docx/index.ts"],
      "@thomasfosterau/effect-ooxml/pptx": ["./packages/ooxml/src/pptx/index.ts"],
      "@thomasfosterau/effect-pdf": ["./packages/pdf/src/index.ts"],
      "@thomasfosterau/effect-pdf/cos": ["./packages/pdf/src/cos/index.ts"],
      "@thomasfosterau/effect-rtf": ["./packages/rtf/src/index.ts"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        // The severities below keep every Effect rule visible in the editor,
        // but a "warning" still fails the patched tsc by default — this flag
        // is what actually makes warnings non-blocking in the check tasks.
        "ignoreEffectWarningsInTscExitCode": true,
        "diagnosticSeverity": {
          "abortControllerInEffect": "warning",
          "asyncFunction": "warning",
          "cryptoRandomUUID": "warning",
          "cryptoRandomUUIDInEffect": "warning",
          "extendsNativeError": "warning",
          "globalConsole": "warning",
          "globalConsoleInEffect": "warning",
          "globalDate": "warning",
          "globalDateInEffect": "warning",
          "globalFetch": "warning",
          "globalFetchInEffect": "warning",
          "globalRandom": "warning",
          "globalRandomInEffect": "warning",
          "globalTimers": "warning",
          "globalTimersInEffect": "warning",
          "instanceOfSchema": "warning",
          "newPromise": "warning",
          "nodeBuiltinImport": "warning",
          "preferSchemaOverJson": "warning",
          "processEnv": "warning",
          "processEnvInEffect": "warning",
          "unsafeEffectTypeAssertion": "warning",
          "unstableApiUsage": "suggestion"
        }
      }
    ]
  }
}
